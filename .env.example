# Linux user/group ID — run `id` to find yours
PUID=1000
PGID=1000

# Timezone — https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Chicago

# Directory where config.yml and state.db will be stored
CONFIG_DIR=./config

# Set to false when running over plain HTTP (e.g., local dev without HTTPS).
# Default is true — always use true behind a reverse proxy with TLS.
SECURE_COOKIES=false

# Secrets may be supplied by the environment rather than config.yml. A field set
# here is never written back to config.yml, so a Settings save cannot clobber a
# rendered secret. Prefer the _FILE form with Docker secrets — it wins if both
# are set. See "Externally managed secrets" in the README.
# JELLYFIN_API_KEY_FILE=/run/secrets/xenotag_jellyfin_api_key
# XENOTAG_SECRET_KEY_FILE=/run/secrets/xenotag_secret_key
# XENOTAG_WEBHOOK_SECRET_FILE=/run/secrets/xenotag_webhook_secret
